{
  "name": "slothai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dictionary:import": "node scripts/import-dictionary.mjs",
    "predev": "npm run dictionary:import -- public/dictionaries/az",
    "dev": "next dev",
    "prebuild": "npm run dictionary:import -- public/dictionaries/az",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "npm run --silent dictionary:import -- public/dictionaries/az",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run dictionary:import -- public/dictionaries/az",
    "test": "node --import tsx --test tests/*.test.ts",
    "gold:audit": "node --import tsx scripts/audit-independent-gold.ts",
    "gold:complete": "node --import tsx scripts/audit-independent-gold.ts --require-complete",
    "benchmark": "node --expose-gc --import tsx scripts/benchmark-editor.ts",
    "benchmark:check": "node --expose-gc --import tsx scripts/benchmark-editor.ts --enforce",
    "benchmark:json": "node --expose-gc --import tsx scripts/benchmark-editor.ts --json",
    "local-ai:expand": "node --import tsx scripts/expand-local-ai.ts",
    "local-ai:fresh": "node --import tsx scripts/evaluate-fresh-ai.ts",
    "local-ai:train": "node --import tsx scripts/train-local-ai.ts",
    "local-ai:evaluate": "node --import tsx scripts/evaluate-local-ai.ts",
    "local-ai:validate": "node --import tsx scripts/evaluate-local-ai.ts --validation",
    "gold:evaluate": "node --import tsx scripts/evaluate-independent-gold.ts",
    "gold:exact": "node --import tsx scripts/evaluate-independent-gold.ts --require-exact",
    "gold:check": "node --import tsx scripts/evaluate-independent-gold.ts --enforce-baseline",
    "local-ai:fresh:check": "node --import tsx scripts/evaluate-fresh-ai.ts --enforce",
    "review:test": "node --import tsx scripts/evaluate-reviewed-file.ts",
    "prereview:test": "npm run --silent dictionary:import -- public/dictionaries/az",
    "local-ai:context": "node --import tsx scripts/evaluate-context-ai.ts",
    "local-ai:context:check": "node --import tsx scripts/evaluate-context-ai.ts --enforce --baseline=data/local-ai/context-baseline.json",
    "local-ai:pos:train": "node --import tsx scripts/import-ud-pos.ts",
    "local-ai:paired:train": "node --import tsx scripts/train-paired-ai.ts",
    "local-ai:paired:check": "node --import tsx scripts/evaluate-paired-ai.ts --baseline=data/local-ai/paired-release-baseline.json --enforce",
    "local-ai:reliability": "node --import tsx scripts/evaluate-paired-reliability.ts",
    "local-ai:rebuild": "npm run local-ai:pos:train && npm run local-ai:train && npm run local-ai:paired:train",
    "neural:corpus": "node --import tsx scripts/build-neural-corpus.ts",
    "neural:train": "node --import tsx scripts/train-neural.ts",
    "neural:continue": "node --import tsx scripts/train-neural.ts --resume",
    "neural:check": "node --import tsx scripts/evaluate-neural.ts --enforce",
    "neural:diversity:check": "node --import tsx scripts/evaluate-neural-diversity.ts --enforce",
    "neural:expansion:check": "node --import tsx scripts/evaluate-neural-expansion.ts --enforce",
    "neural:attention:train": "node --import tsx scripts/train-attention.ts",
    "neural:attention:check": "node --import tsx scripts/evaluate-attention.ts --enforce",
    "neural:attention:independent:check": "node --import tsx scripts/evaluate-attention.ts --independent --enforce",
    "nlp:data": "node --import tsx scripts/build-correction-data.ts",
    "nlp:evaluate": "node --import tsx scripts/evaluate-correction-quality.ts",
    "nlp:ablation": "node --import tsx scripts/train-attention-experiments.ts",
    "nlp:select": "node --import tsx scripts/select-bounded-model.ts",
    "nlp:compact": "node --import tsx scripts/compact-bounded-model.ts",
    "nlp:reviewed": "node --import tsx scripts/import-reviewed-training.ts",
    "nlp:reviewed:data": "node --import tsx scripts/build-reviewed-neural-data.ts",
    "nlp:reviewed:verify": "node --import tsx scripts/verify-reviewed-neural-artifact.ts",
    "quality:priorities": "node --import tsx scripts/check-priority-quality.ts --enforce",
    "neural:boundaries:train": "node --import tsx scripts/train-sentence-boundaries.ts",
    "neural:boundaries:check": "node --import tsx scripts/evaluate-sentence-boundaries.ts --enforce",
    "nlp:domain:data": "node --import tsx scripts/build-domain-neural-data.ts",
    "nlp:domain:compact": "node --import tsx scripts/compact-domain-model.ts",
    "nlp:domain:select": "node --import tsx scripts/select-domain-model.ts",
    "nlp:domain:evaluate": "node --import tsx scripts/evaluate-domain-neural.ts",
    "nlp:observed:train": "node --import tsx scripts/train-observed-channel.ts",
    "nlp:observed:evaluate": "node --import tsx scripts/evaluate-observed-inputs.ts",
    "nlp:document:train": "node --import tsx scripts/train-document-spelling.ts",
    "nlp:document:evaluate": "node --import tsx scripts/evaluate-document-spelling.ts",
    "nlp:log:train": "node --import tsx scripts/train-log-spelling.ts && node --import tsx scripts/train-log-ocr.ts",
    "nlp:log:evaluate": "node --import tsx scripts/evaluate-log-spelling.ts",
    "nlp:institutions:train": "node --import tsx scripts/train-institutional-spelling.ts",
    "nlp:institutions:check": "node --import tsx scripts/evaluate-institutional-spelling.ts --enforce",
    "eval:phase0": "node --import tsx scripts/eval/run.ts --out=docs/stage1/evaluation",
    "eval:ablation": "node --import tsx scripts/eval/ablation.ts --out=docs/stage1/evaluation",
    "eval:latency": "node --import tsx scripts/eval/latency.ts --policy=default --out=docs/stage1/evaluation/latency.json",
    "data:test": "python3 -m unittest discover -s scripts/data -p test_*.py",
    "data:gate": "python3 scripts/data/gate.py data/corpus/az-v1 --out=docs/stage1/collection/gate.json",
    "eval:targets": "node --import tsx scripts/eval/targets.ts",
    "eval:fixtures": "node --import tsx scripts/eval/snapshot.ts --out=docs/stage1/evaluation",
    "training:status": "python3 -m training.cli status",
    "training:import": "python3 -m training.cli import",
    "training:verify": "python3 -m training.cli verify",
    "pretraining:prepare": "npm run --silent dictionary:import -- public/dictionaries/az",
    "training:prepare": "python3 -m training.cli prepare",
    "training:test": "python3 -m unittest discover -s training/tests -p 'test_*.py'",
    "training:test:models": ".venv-training/bin/python -m unittest training.tests.test_models",
    "training:charspell": ".venv-training/bin/python -m training.cli train charspell",
    "training:wordlm": "python3 -m training.cli train wordlm",
    "training:punctcase": ".venv-training/bin/python -m training.cli train punctcase"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.13",
    "typescript": "^5.7.2"
  }
}
