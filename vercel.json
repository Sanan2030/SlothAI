{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "regions": ["fra1"],
  "functions": {
    "app/api/**/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
